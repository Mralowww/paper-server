# Flask
FLASK_SECRET_KEY=請填一組長隨機字串
PORT=8787

# Discord OAuth (網站登入用) - 到 https://discord.com/developers/applications 建立 App 取得
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/discord/callback

# 第一個管理員的 Discord 使用者 ID(右鍵你的頭像 > 複製使用者 ID,需開發者模式)
SEED_ADMIN_DISCORD_ID=

# 遊戲伺服器插件 (TierVerify) 呼叫 /internal/verify 時要帶的密鑰,必須跟插件 config.yml 的 shared-secret 一致
PLUGIN_SHARED_SECRET=請填一組長隨機字串

# Discord bot (discord_bot/bot.py) 用
DISCORD_BOT_TOKEN=
ANNOUNCE_CHANNEL_ID=
POLL_INTERVAL_SECONDS=60
