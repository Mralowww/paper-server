# Flask
FLASK_SECRET_KEY=請填一組長隨機字串
PORT=8787

# Discord OAuth (網站登入用) - 到 https://discord.com/developers/applications 建立 App 取得
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8787/discord/callback

# 你的 Discord 伺服器 ID(右鍵伺服器圖示 > 複製伺服器 ID,需開發者模式)
# 網站跟 DC bot 的管理員權限都是看這個伺服器裡誰有 Administrator 權限(包含伺服器擁有者),不用另外維護名單
DISCORD_GUILD_ID=

# 遊戲伺服器插件 (TierVerify) 呼叫 /internal/verify 時要帶的密鑰,必須跟插件 config.yml 的 shared-secret 一致
PLUGIN_SHARED_SECRET=請填一組長隨機字串

# Discord bot (discord_bot/bot.py) 用
DISCORD_BOT_TOKEN=
ANNOUNCE_CHANNEL_ID=
POLL_INTERVAL_SECONDS=60
# 主機一次只能跑一支 Python 程式(例如 Pterodactyl 的 Generic Python egg)時,
# 設成 1 會讓 app.py 啟動時順便在背景執行緒把 Discord bot 也跑起來,不用另外開一支程序
RUN_BOT_IN_WEB_PROCESS=0

# 考試系統
# 考官身份組 ID(右鍵身份組 > 複製 ID,需開發者模式)
EXAMINER_ROLE_ID=
# 考試單頻道要建立在哪個分類 (Category) 底下,右鍵分類 > 複製 ID
TICKET_CATEGORY_ID=
# 考試結果要同步公告到哪個頻道(可留空,只發在考試單頻道裡)
RESULTS_CHANNEL_ID=
