# Discord Developer Portal → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 必須與 Developer Portal 中設定的 Redirect 完全相同
DISCORD_REDIRECT_URI=https://www.sawsmp.me/auth/callback
# Discord Developer Portal → Bot
DISCORD_BOT_TOKEN=
# 權限身分組（逗號分隔）：客服 / 管理員 / 最高管理；設定後只依這些 ID 判定
SUPPORT_ROLE_IDS=
MOD_ROLE_IDS=
# 綁定 Minecraft 後自動給予的身分組
LINKED_ROLE_ID=
# 擁有者 Discord ID（逗號分隔，永遠是最高權限）
OWNER_IDS=
# 你的 Discord 伺服器 ID
DISCORD_GUILD_ID=
# 額外視為管理員的身分組 ID（逗號分隔，可留空；擁有 Administrator / Manage Server 權限者自動是管理員）
ADMIN_ROLE_IDS=
# 每週公告前三名的頻道 ID
ANNOUNCE_CHANNEL_ID=
REQUIRE_GUILD_MEMBER=true

# 隨機長字串，用來簽署登入 Cookie
SESSION_SECRET=
TIMEZONE=Asia/Taipei
SCRAPE_INTERVAL_MIN=60
MAX_LINKS_PER_WEEK=10
DATABASE_PATH=data/rewards.db
DEV_LOGIN=false
