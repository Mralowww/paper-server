# Discord Developer Portal → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 必須與 Developer Portal 中設定的 Redirect 完全相同
DISCORD_REDIRECT_URI=http://tw4.shdctw.com:25463/auth/callback
# Discord Developer Portal → Bot
DISCORD_BOT_TOKEN=
# 你的 Discord 伺服器 ID
DISCORD_GUILD_ID=
# 額外視為管理員的身分組 ID（逗號分隔，可留空；擁有 Administrator / Manage Server 權限者自動是管理員）
ADMIN_ROLE_IDS=
# 每週公告前三名的頻道 ID
ANNOUNCE_CHANNEL_ID=
REQUIRE_GUILD_MEMBER=true

# 隨機長字串，用來簽署登入 Cookie
SESSION_SECRET=
TIMEZONE=Asia/Taipei
SCRAPE_INTERVAL_MIN=60
MAX_LINKS_PER_WEEK=10
DATABASE_PATH=data/rewards.db
DEV_LOGIN=false
