# 網站對外網址（必須與 Discord Developer Portal 裡設定的 Redirect 網域一致，不要以 / 結尾）
BASE_URL=https://mc.tierlist.asia
# 託管若有提供 SERVER_PORT 會自動使用
PORT=3000

# 隨機長字串，用來簽署登入 Cookie（可用 `openssl rand -hex 32` 產生）
SESSION_SECRET=

# Discord OAuth2（https://discord.com/developers/applications → OAuth2）
# Redirect URL 請填：{BASE_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord 機器人（Developer Portal → Bot；需開啟 Server Members Intent）
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# 不論 Discord 身分組，永遠擁有最高權限的帳號（逗號分隔）
SUPER_ADMIN_IDS=995145509897523221

# 官方 Minecraft 伺服器位址（顯示在網站上）
# SERVER_ADDRESS=Mc.Tierlist.Asia

# 考試冷卻天數
# TEST_COOLDOWN_DAYS=7

# 選填
# DATA_DIR=./data
# API_RATE_LIMIT_PER_MIN=60
# 正式環境請設為 production（會強制要求 SESSION_SECRET）
APP_ENV=production
